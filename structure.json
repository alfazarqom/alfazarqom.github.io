{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Asri Collection App Structure",
    "artifact": "structure.json",
    "version": "2.0.0",
    "status": "implemented-frontend-baseline",
    "purpose": "React application architecture and UI composition blueprint",
    "source_of_truth": true,
    "last_updated": "2026-11-04"
  },
  "project": {
    "name": "Asri Collection",
    "repository": "alfazarqom/alfazarqom.github.io",
    "platform": "GitHub Pages",
    "application_type": "static-single-page-storefront",
    "locale": "id-ID",
    "currency": "IDR"
  },
  "architecture": {
    "pattern": "React single-page application",
    "runtime": "React UMD + Babel Standalone in browser",
    "framework": "React 18.3.1",
    "language": [
      "HTML5",
      "CSS",
      "JavaScript",
      "JSX"
    ],
    "build_required": false,
    "bundler": null,
    "routing": {
      "type": "custom hash router",
      "library": null,
      "mechanism": "location.hash and hashchange",
      "back_forward": true
    },
    "jsx_loading": {
      "compiler": "Babel Standalone 7.26.10",
      "strategy": "loader fetches and compiles JSX files sequentially before mounting",
      "module_system": "shared window.ASRI namespace; no import/export"
    },
    "principles": [
      "Keep GitHub Pages as static hosting with no build step.",
      "Separate page composition, reusable components, data access, and styling responsibilities.",
      "Read product data from the existing Supabase get-products Edge Function.",
      "Do not add hardcoded or demo product fallback data.",
      "Distinguish implemented frontend behavior from architectural placeholders and backend-dependent features."
    ]
  },
  "app": {
    "root": "#root",
    "component": "App",
    "tree": {
      "App": {
        "children": [
          {
            "component": "AppShell",
            "regions": [
              "AppHeader",
              "MainContent",
              "AppFooter",
              "BottomNavigation"
            ],
            "page_groups": [
              "HomePage",
              "ShopPage",
              "ProductListingPage",
              "CategoryPage",
              "SubcategoryPage",
              "SearchPage",
              "NewArrivalsPage",
              "BestSellersPage",
              "FeaturedProductsPage",
              "SalePage",
              "ComingSoonPage",
              "BrandPage",
              "CollectionPage",
              "BlogPage",
              "BlogDetailPage",
              "PromotionsPage",
              "StoreLocatorPage",
              "HelpCenterPage",
              "FAQPage"
            ]
          },
          {
            "component": "StandalonePages",
            "layout": [
              "MinimalHeader",
              "StandaloneContent",
              "BottomActionBar optional",
              "AppFooter"
            ],
            "primary_action_rule": "Only functional, transactional, or form-submit primary actions require StandalonePages. Ordinary navigation CTAs remain in AppShell.",
            "bottom_action_bar": {
              "positioning": "normal document flow",
              "fixed": false,
              "absolute": false,
              "sticky_by_default": false
            },
            "page_groups": [
              "ProductDetailPage",
              "CartPage",
              "WishlistPage",
              "CompareProductsPage",
              "CheckoutPage",
              "ShippingAddressPage",
              "ShippingMethodPage",
              "PaymentMethodPage",
              "OrderReviewPage",
              "PaymentPage",
              "OrderSuccessPage",
              "OrderFailedPage",
              "PaymentReturnPage",
              "OrderDetailPage",
              "OrderTrackingPage",
              "OrderCancellationPage",
              "ReturnsRefundsPage",
              "ProfilePage",
              "AddressesPage",
              "AccountSettingsPage",
              "NotificationsPage",
              "ContactPage",
              "LiveChatPage",
              "HelpRequestPage",
              "AuthenticationPages",
              "LegalPages"
            ]
          },
          {
            "component": "Overlays",
            "scope": "global, outside route classification",
            "items": [
              "Modal",
              "Drawer",
              "BottomSheet",
              "QuickView",
              "FilterDrawer",
              "SortBottomSheet",
              "VariantSelector",
              "ImageGalleryModal",
              "ConfirmationModal",
              "Toast"
            ]
          }
        ]
      }
    }
  },
  "layouts": {
    "AppShell": {
      "implemented": true,
      "regions": [
        "AppHeader",
        "MainContent",
        "AppFooter",
        "BottomNavigation"
      ],
      "purpose": "Browsing, discovery, navigation, and informational pages"
    },
    "StandaloneLayout": {
      "implemented": true,
      "regions": [
        "MinimalHeader",
        "StandaloneContent",
        "BottomActionBar optional",
        "AppFooter"
      ],
      "purpose": "Functional, transactional, and form-submit page flows"
    },
    "BottomActionBar": {
      "implemented": true,
      "positioning": "normal document flow",
      "fixed": false,
      "absolute": false
    },
    "Overlays": {
      "implemented": "toast shell; other overlay primitives reserved",
      "purpose": "Global transient UI independent of route layout"
    }
  },
  "pages": {
    "implemented": [
      "HomePage",
      "CatalogPage",
      "ProductDetailPage",
      "CartPage",
      "WishlistPage",
      "CheckoutPreviewPage"
    ],
    "architectural_placeholders": [
      "CategoryPage",
      "SubcategoryPage",
      "SearchPage",
      "NewArrivalsPage",
      "BestSellersPage",
      "FeaturedProductsPage",
      "SalePage",
      "ComingSoonPage",
      "BrandPage",
      "CollectionPage",
      "BlogPage",
      "BlogDetailPage",
      "PromotionsPage",
      "StoreLocatorPage",
      "HelpCenterPage",
      "FAQPage",
      "OrderPages",
      "CustomerPages",
      "ServicePages",
      "AuthenticationPages",
      "LegalPages"
    ],
    "product_detail": {
      "route": "#/products/:id",
      "presentation": "dedicated StandalonePage",
      "legacy_dialog": false
    }
  },
  "data": {
    "provider": "Supabase Edge Function",
    "source_of_truth": "existing public product catalog through get-products",
    "endpoint": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-products",
    "method": "GET",
    "client": "browser fetch",
    "response_envelope": [
      "success",
      "data",
      "total"
    ],
    "rules": [
      "Do not query the products table directly from this frontend.",
      "Do not add demo or hardcoded product fallback data.",
      "Validate HTTP response, response envelope, and product identifiers.",
      "Availability is a purchase-status field and is displayed separately from stock quantity.",
      "Do not silently hide products because stock quantity is zero."
    ]
  },
  "state": {
    "framework": "React Hooks",
    "persistent": [
      "cart",
      "wishlist"
    ],
    "storage": "browser localStorage",
    "server_state": [
      "product catalog"
    ]
  },
  "styles": {
    "source_of_truth": "blueprint-design-system.json",
    "files": [
      "css/tokens.css",
      "css/global.css",
      "css/layout.css",
      "css/components.css",
      "css/responsive.css"
    ],
    "responsive_strategy": "mobile-first responsive web"
  },
  "repository_files": {
    "index.html": "Static document, CDN dependencies, and React root",
    "js/config.js": "Application and public catalog endpoint configuration",
    "js/loader.js": "Sequential JSX fetch, Babel compilation, and React mount",
    "js/core.jsx": "Formatting, catalog hook, persistence hook, and data helpers",
    "js/components.jsx": "Shared navigation, product, feedback, and layout components",
    "js/pages.jsx": "Storefront, catalog, product, cart, wishlist, checkout preview, and generic page components",
    "js/app.jsx": "Application composition and hash route mapping",
    "css/": "Layered design-system styles",
    "blueprint-design-system.json": "Visual design-system source of truth",
    "docs/": "Human-readable design and provider documentation"
  },
  "backend_boundary": {
    "catalog_read": "existing endpoint only",
    "database_changes": false,
    "edge_function_changes": false,
    "order_creation": "not implemented",
    "payment_processing": "not implemented",
    "authentication": "not implemented"
  },
  "constraints": [
    "Do not describe placeholder routes as completed business functionality.",
    "Do not claim checkout, order, payment, shipping, tracking, or authentication is integrated.",
    "Do not change Supabase project configuration or credentials as part of the frontend migration.",
    "Keep BottomActionBar in normal document flow; never fixed or absolute.",
    "Ordinary navigation CTAs remain in AppShell."
  ]
}
