  "data": {
    "provider": "Supabase Edge Function",
    "source_of_truth": "public.divoom_products",
    "endpoint": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-divoom-products",
    "method": "GET",
    "client": "browser fetch()",
    "service_source": "App.jsx",
    "expected_response": {
      "success": "boolean",
      "data": "array of Divoom product objects",
      "total": "number"
    },
    "rules": [
      "Do not query the products table directly from this frontend.",
      "Do not add hardcoded or demo product fallback data.",
      "Validate the HTTP response and Divoom product JSON fields before rendering.",
      "Keep loading, error, retry, and empty states explicit."
    ],
    "product_fields": [
      "id",
      "item_group_id",
      "title",
      "description",
      "rich_text_description",
      "availability",
      "condition",
      "price",
      "sale_price",
      "link",
      "image_link",
      "additional_image_link",
      "brand",
      "google_product_category",
      "product_type",
      "color",
      "size",
      "material",
      "pattern",
      "gender",
      "age_group",
      "additional_variant_attribute",
      "created_at",
      "updated_at"
    ],
    "field_rules": [
      "Prices are numeric IDR values; sale_price may be null.",
      "Use image_link as the primary product image.",
      "additional_image_link is a JSON array of image URLs for the product gallery.",
      "Use product_type for the product category and color for the variant color.",
      "Treat availability values such as in stock and out of stock as catalog status, not as a stock quantity."
    ]
  },
  "styles": {
    "global_stylesheet": "style.css",
    "design_system_blueprint": "blueprint-design-system.json",
    "design_system_documentation": "docs/DESIGN_SYSTEM.md",
    "responsive_strategy": "mobile-only",
    "layout_contract": {
      "html_body": "width: 100%; height: 100%; margin: 0",
      "root": "#root",
      "app_shell": "full-height flex column",
      "main": "flexible primary content region"
    },
    "rule": "The design system blueprint is the source of truth for visual tokens; avoid duplicating token definitions in this file.",
    "mobile_only": {
      "minimum_viewport_width_px": 320,
      "maximum_viewport_width_px": 767,
      "wide_viewport_behavior": "Application remains centered and capped at 767px; no desktop or tablet layout is provided."
    }
  },
  "repository_files": {
    "index.html": "HTML document, root mount point, React and Babel CDN runtime, and URL restoration for GitHub Pages deep links.",
    "App.jsx": "React application, route resolution, product fetching, search, and product group detail page.",
    "style.css": "Global styles, layout, components, product detail route, and responsive rules.",
    "README.md": "Project overview, technology, data source, local preview, and GitHub Pages instructions",
    "blueprint-design-system.json": "Structured design-system specification and visual token source",
    "docs/DESIGN_SYSTEM.md": "Human-readable design-system documentation",
    "structure.json": "Application structure and architecture blueprint",
    "404.html": "GitHub Pages fallback redirect that preserves the requested deep route and query string."
  },
  "constraints": [
    "Describe the current implementation as a React CDN application with native CSS and no build step.",
    "Do not claim Vite, TypeScript, npm scripts, React Router, or a build pipeline are implemented.",
    "React and ReactDOM are loaded from CDN; Babel Standalone compiles JSX in the browser.",
    "Do not add demo product fallback data when the Supabase Edge Function request fails.",
    "Architecture changes must be reflected in this file when the implementation changes.",
    "BottomNavigation is exclusive to Home, Products, and Profile.",
    "BottomActionBar is exclusive to ProductDetail, Search, Cart, Checkout, OrderSuccess, OrderTracking, Wishlist, and Contact.",
    "Do not represent placeholder routes as completed commerce features.",
    "ProductCard navigates to /products/{item_group_id}; ProductQuickView is not the product-card navigation target."
  ],
  "overlays": {
    "implemented": [],
    "planned": [
      "CartDrawer",
      "SearchOverlay",
      "ConfirmationDialog",
      "Toast"
    ],
    "placement": "Outside AppShell"
  }
