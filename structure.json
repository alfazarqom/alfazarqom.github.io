{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Asri Collection App Structure",
    "artifact": "structure.json",
    "version": "1.3.0",
    "status": "current",
    "purpose": "Application architecture and UI composition blueprint",
    "source_of_truth": true,
    "last_updated": "2026-11-05"
  },
  "project": {
    "name": "Asri Collection",
    "repository": "alfazarqom/alfazarqom.github.io",
    "platform": "GitHub Pages",
    "application_type": "static-web-storefront",
    "locale": "id-ID",
    "currency": "IDR"
  },
  "architecture": {
    "pattern": "single-page static application",
    "runtime": "React 18 UMD and ReactDOM 18 UMD loaded from CDN; Babel Standalone compiles JSX in the browser; native CSS",
    "framework": "React 18 (CDN UMD)",
    "language": [
      "HTML5",
      "JSX",
      "JavaScript",
      "CSS"
    ],
    "build_required": false,
    "routing": {
      "type": "client-side route resolution with product path routes and hash-based placeholder pages",
      "library": null,
      "mechanism": "window.location.pathname, window.location.hash, history.pushState, popstate, and hashchange",
      "product_detail_pattern": "/products/{item_group_id}",
      "direct_url_fallback": "404.html redirects to the root entry point with the requested path encoded in ?p=; index.html restores the original pathname before React resolves the route.",
      "implemented_pages": [
        "home",
        "products",
        "productDetail",
        "profile",
        "search",
        "cart",
        "checkout",
        "orderSuccess",
        "orderTracking",
        "wishlist",
        "contact"
      ],
      "note": "ProductDetail resolves the item_group_id from the URL and renders all catalog variants in that group. Other not-yet-built pages remain placeholders."
    },
    "principles": [
      "Keep the current no-build GitHub Pages architecture.",
      "Keep layout ownership at the application shell level.",
      "Separate page content, reusable UI patterns, data access, and styling responsibilities.",
      "Render Divoom product data from the Supabase get-divoom-products Edge Function; do not add demo product fallbacks.",
      "Treat this file as an architecture reference, not as a claim that conceptual components already exist as separate source files.",
      "The application is mobile-only and supports viewport widths from 320px through 767px."
    ]
  },
  "app": {
    "root": "#root",
    "component": "App",
    "tree": {
      "App": {
        "element": "#root",
        "children": [
          {
            "component": "AppShell",
            "element": ".app-shell",
            "children": [
              {
                "component": "Header",
                "element": ".site-header",
                "children": [
                  "BrandLockup",
                  "MainNavigation",
                  "SearchButton",
                  "WishlistButton",
                  "CartButton"
                ]
              },
              {
                "component": "Main",
                "element": ".main-content",
                "children": [
                  {
                    "component": "MainContent",
                    "element": ".main-content-inner",
                    "children": [
                      {
                        "component": "PagesLayout",
                        "children": [
                          {
                            "page": "Home",
                            "element": "#home-page",
                            "children": [
                              "HeroSection",
                              "IntroStrip",
                              "FeaturedProductsSection"
                            ]
                          },
                          {
                            "page": "Products",
                            "element": "#products-page",
                            "children": [
                              "CatalogHeading",
                              "CatalogToolbar",
                              "ProductGrid"
                            ]
                          },
                          "PageFooter"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "component": "PageNavigation",
                "element": ".bottom-navigation | .bottom-action-bar",
                "rendering": "Exactly one navigation component is rendered according to the active page."
              }
            ]
          },
          {
            "component": "Overlays",
            "children": [
              {
                "component": "ProductQuickView",
                "element": ".product-dialog",
                "rendering": "React-controlled native HTML dialog"
              }
            ]
          }
        ]
      }
    },
    "navigation_policy": {
      "mobile_only": true,
      "supported_viewport_width_px": {
        "minimum": 320,
        "maximum": 767
      },
      "BottomNavigation": {
        "pages": [
          "Home",
          "Products",
          "Profile"
        ],
        "mutually_exclusive_with": "BottomActionBar"
      },
      "BottomActionBar": {
        "pages": [
          "ProductDetail",
          "Search",
          "Cart",
          "Checkout",
          "OrderSuccess",
          "OrderTracking",
          "Wishlist",
          "Contact"
        ],
        "mutually_exclusive_with": "BottomNavigation"
      },
      "footer": "Footer is rendered inside each page.",
      "order": [
        "Header",
        "Main",
        "active bottom navigation component"
      ]
    }
  },
  "layouts": {
    "AppShell": {
      "implemented": true,
      "element": ".app-shell",
      "direction": "column",
      "regions": [
        "Header",
        "Main",
        "PageNavigation"
      ],
      "footer_ownership": "Each page owns and renders its own PageFooter."
    },
    "Main": {
      "implemented": true,
      "element": ".main-content",
      "responsibility": "Primary page viewport and scrolling region"
    },
    "PagesLayout": {
      "implemented": true,
      "element": ".main-content-inner",
      "responsibility": "Contains page sections; only the active page is visible"
    },
    "OverlayLayout": {
      "implemented": "native-dialog",
      "responsibility": "Product detail modal outside the normal document flow"
    }
  },
  "pages": {
    "Home": {
      "implemented": true,
      "element": "#home-page",
      "sections": [
        "HeroSection",
        "IntroStrip",
        "FeaturedProductsSection"
      ]
    },
    "Products": {
      "implemented": true,
      "element": "#products-page",
      "sections": [
        "CatalogHeading",
        "CatalogToolbar",
        "ProductGrid"
      ],
      "features": [
        "ProductSearch",
        "ProductCount"
      ]
    },
    "ProductDetail": {
      "implemented": true,
      "content_status": "implemented",
      "navigation": "BottomActionBar",
      "route": "/products/{item_group_id}",
      "data_resolution": "Filter fetched catalog rows by exact item_group_id",
      "variant_selection": "All variants in the group are selectable on the product detail page",
      "direct_url": "Supported through the GitHub Pages 404.html fallback"
    },
    "Orders": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    },
    "Livechat": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    },
    "Profile": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomNavigation"
    },
    "Search": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Cart": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Checkout": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "OrderSuccess": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "OrderTracking": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Wishlist": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Contact": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    }
  },
  "components": {
    "Header": {
      "implemented": true,
      "source": "App.jsx"
    },
    "BrandLockup": {
      "implemented": true,
      "source": "App.jsx"
    },
    "MainNavigation": {
      "implemented": true,
      "source": "App.jsx",
      "behavior_source": "App.jsx"
    },
    "HeroSection": {
      "implemented": true,
      "source": "App.jsx"
    },
    "IntroStrip": {
      "implemented": true,
      "source": "App.jsx"
    },
    "FeaturedProductsSection": {
      "implemented": true,
      "source": "App.jsx"
    },
    "CatalogToolbar": {
      "implemented": true,
