{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Asri Collection App Structure",
    "artifact": "structure.json",
    "version": "1.3.0",
    "status": "current",
    "purpose": "Application architecture and UI composition blueprint",
    "source_of_truth": true,
    "last_updated": "2026-11-05"
  },
  "project": {
    "name": "Asri Collection",
    "repository": "alfazarqom/alfazarqom.github.io",
    "platform": "GitHub Pages",
    "application_type": "static-web-storefront",
    "locale": "id-ID",
    "currency": "IDR"
  },
  "architecture": {
    "pattern": "single-page static application",
    "runtime": "React 18 UMD and ReactDOM 18 UMD loaded from CDN; Babel Standalone compiles JSX in the browser; native CSS",
    "framework": "React 18 (CDN UMD)",
    "language": [
      "HTML5",
      "JSX",
      "JavaScript",
      "CSS"
    ],
    "build_required": false,
    "routing": {
      "type": "in-page React state navigation synchronized with URL hash",
      "library": null,
      "mechanism": "React state and window.location.hash",
      "implemented_pages": [
        "home",
        "products",
        "productDetail",
        "search",
        "cart",
        "checkout",
        "orderSuccess",
        "orderTracking",
        "wishlist",
        "profile",
        "contact"
      ],
      "note": "All eleven target routes now render page-specific storefront UI. Cart, wishlist, guest profile, contact message drafts, and order drafts are browser-local. No order submission, payment, stock reservation, or server-side tracking is implemented."
    },
    "principles": [
      "Keep the current no-build GitHub Pages architecture.",
      "Keep layout ownership at the application shell level.",
      "Separate page content, reusable UI patterns, data access, and styling responsibilities.",
      "Render product data from the Supabase get-products Edge Function; do not add demo product fallbacks.",
      "Treat this file as an architecture reference, not as a claim that conceptual components already exist as separate source files.",
      "The application is mobile-only and supports viewport widths from 320px through 767px."
    ]
  },
  "app": {
    "root": "#root",
    "component": "App",
    "tree": {
      "App": {
        "element": "#root",
        "children": [
          {
            "component": "AppShell",
            "element": ".app-shell",
            "children": [
              {
                "component": "Header",
                "element": ".site-header",
                "children": [
                  "BrandLockup",
                  "MainNavigation",
                  "SearchButton",
                  "WishlistButton",
                  "CartButton"
                ]
              },
              {
                "component": "Main",
                "element": ".main-content",
                "children": [
                  {
                    "component": "MainContent",
                    "element": ".main-content-inner",
                    "children": [
                      {
                        "component": "PagesLayout",
                        "children": [
                          {
                            "page": "Home",
                            "element": "#home-page",
                            "children": [
                              "HeroSection",
                              "IntroStrip",
                              "FeaturedProductsSection",
                              "PageFooter"
                            ]
                          },
                          {
                            "page": "Products",
                            "element": "#products-page",
                            "children": [
                              "CatalogHeading",
                              "CatalogToolbar",
                              "ProductGrid"
                            ]
                          },
                          "PageFooter",
                          {
                            "page": "ProductDetail",
                            "component": "Pages.Detail"
                          },
                          {
                            "page": "Search",
                            "component": "Pages.Search"
                          },
                          {
                            "page": "Cart",
                            "component": "Pages.Cart"
                          },
                          {
                            "page": "Checkout",
                            "component": "Pages.Checkout"
                          },
                          {
                            "page": "OrderSuccess",
                            "component": "Pages.OrderSuccess"
                          },
                          {
                            "page": "OrderTracking",
                            "component": "Pages.Tracking"
                          },
                          {
                            "page": "Wishlist",
                            "component": "Pages.Wishlist"
                          },
                          {
                            "page": "Profile",
                            "component": "Pages.Profile"
                          },
                          {
                            "page": "Contact",
                            "component": "Pages.Contact"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "component": "PageNavigation",
                "element": ".bottom-navigation | .bottom-action-bar",
                "rendering": "Exactly one navigation component is rendered according to the active page."
              }
            ]
          },
          {
            "component": "Overlays",
            "children": [
              {
                "component": "ProductQuickView",
                "element": ".product-dialog",
                "rendering": "React-controlled native HTML dialog"
              }
            ]
          }
        ]
      }
    },
    "navigation_policy": {
      "mobile_only": true,
      "supported_viewport_width_px": {
        "minimum": 320,
        "maximum": 767
      },
      "BottomNavigation": {
        "pages": [
          "Home",
          "Products",
          "Profile"
        ],
        "mutually_exclusive_with": "BottomActionBar"
      },
      "BottomActionBar": {
        "pages": [
          "ProductDetail",
          "Search",
          "Cart",
          "Checkout",
          "OrderSuccess",
          "OrderTracking",
          "Wishlist",
          "Contact"
        ],
        "mutually_exclusive_with": "BottomNavigation"
      },
      "footer": "Footer is rendered inside each page.",
      "order": [
        "Header",
        "Main",
        "active bottom navigation component"
      ],
      "storage": {
        "cart": "localStorage: asri-cart-v1",
        "wishlist": "localStorage: asri-wishlist-v1",
        "guestProfile": "localStorage: asri-customer-v1",
        "orderDrafts": "localStorage: asri-local-orders-v1"
      },
      "checkout": "Creates a local-only draft. Does not submit an order, reserve stock, charge payment, or confirm fulfillment.",
      "orderTracking": "Searches only local order drafts stored in the current browser.",
      "contact": "Copies a message draft; no official recipient/channel is configured and no message is sent."
    }
  },
