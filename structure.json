{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Asri Collection App Structure",
    "artifact": "structure.json",
    "version": "1.2.0",
    "status": "current",
    "purpose": "Application architecture and UI composition blueprint",
    "source_of_truth": true,
    "last_updated": "2026-11-05"
  },
  "project": {
    "name": "Asri Collection",
    "repository": "alfazarqom/alfazarqom.github.io",
    "platform": "GitHub Pages",
    "application_type": "static-web-storefront",
    "locale": "id-ID",
    "currency": "IDR"
  },
  "architecture": {
    "pattern": "single-page static application",
    "runtime": "React 18 UMD and ReactDOM 18 UMD loaded from CDN; Babel Standalone compiles JSX in the browser; native CSS",
    "framework": "React 18 (CDN UMD)",
    "language": [
      "HTML5",
      "JSX",
      "JavaScript",
      "CSS"
    ],
    "build_required": false,
    "routing": {
      "type": "in-page React state navigation synchronized with URL hash",
      "library": null,
      "mechanism": "React state and window.location.hash",
      "implemented_pages": [
        "home",
        "products",
        "profile",
        "productDetail",
        "search",
        "cart",
        "checkout",
        "orderSuccess",
        "orderTracking",
        "wishlist",
        "contact"
      ],
      "note": "Home and Products retain their existing storefront features. Profile and the remaining routes currently render explicit placeholders pending feature implementation."
    },
    "principles": [
      "Keep the current no-build GitHub Pages architecture.",
      "Keep layout ownership at the application shell level.",
      "Separate page content, reusable UI patterns, data access, and styling responsibilities.",
      "Render product data from the Supabase get-products Edge Function; do not add demo product fallbacks.",
      "Treat this file as an architecture reference, not as a claim that conceptual components already exist as separate source files.",
      "The application is mobile-only and supports viewport widths from 320px through 767px."
    ]
  },
  "app": {
    "root": "#root",
    "component": "App",
    "tree": {
      "App": {
        "element": "#root",
        "children": [
          {
            "component": "AppShell",
            "element": ".app-shell",
            "children": [
              {
                "component": "Header",
                "element": ".site-header",
                "children": [
                  "BrandLockup",
                  "MainNavigation",
                  "HeaderCTA"
                ]
              },
              {
                "component": "Main",
                "element": ".main-content",
                "children": [
                  {
                    "component": "MainContent",
                    "element": ".main-content-inner",
                    "children": [
                      {
                        "component": "PagesLayout",
                        "children": [
                          {
                            "page": "Home",
                            "element": "#home-page",
                            "children": [
                              "HeroSection",
                              "IntroStrip",
                              "FeaturedProductsSection"
                            ]
                          },
                          {
                            "page": "Products",
                            "element": "#products-page",
                            "children": [
                              "CatalogHeading",
                              "CatalogToolbar",
                              "ProductGrid"
                            ]
                          },
                          "PageFooter"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "component": "PageNavigation",
                "element": ".bottom-navigation | .bottom-action-bar",
                "rendering": "Exactly one navigation component is rendered according to the active page."
              }
            ]
          },
          {
            "component": "ProductDialog",
            "element": ".product-dialog",
            "rendering": "React-controlled native HTML dialog"
          }
        ]
      }
    },
    "navigation_policy": {
      "mobile_only": true,
      "supported_viewport_width_px": {
        "minimum": 320,
        "maximum": 767
      },
      "BottomNavigation": {
        "pages": [
          "Home",
          "Products",
          "Profile"
        ],
        "mutually_exclusive_with": "BottomActionBar"
      },
      "BottomActionBar": {
        "pages": [
          "ProductDetail",
          "Search",
          "Cart",
          "Checkout",
          "OrderSuccess",
          "OrderTracking",
          "Wishlist",
          "Contact"
        ],
        "mutually_exclusive_with": "BottomNavigation"
      },
      "footer": "Footer is rendered inside each page.",
      "order": [
        "Header",
        "Main",
        "active bottom navigation component"
      ]
    }
  },
  "layouts": {
    "AppShell": {
      "implemented": true,
      "element": ".app-shell",
      "direction": "column",
      "regions": [
        "Header",
        "Main",
        "PageNavigation"
      ],
      "footer_ownership": "Each page owns and renders its own PageFooter."
    },
    "Main": {
      "implemented": true,
      "element": ".main-content",
      "responsibility": "Primary page viewport and scrolling region"
    },
    "PagesLayout": {
      "implemented": true,
      "element": ".main-content-inner",
      "responsibility": "Contains page sections; only the active page is visible"
    },
    "OverlayLayout": {
      "implemented": "native-dialog",
      "responsibility": "Product detail modal outside the normal document flow"
    }
  },
  "pages": {
    "Home": {
      "implemented": true,
      "element": "#home-page",
      "sections": [
        "HeroSection",
        "IntroStrip",
        "FeaturedProductsSection"
      ]
    },
    "Products": {
      "implemented": true,
      "element": "#products-page",
      "sections": [
        "CatalogHeading",
        "CatalogToolbar",
        "ProductGrid"
      ],
      "features": [
        "ProductSearch",
        "ProductCount"
      ]
    },
    "ProductDetail": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar",
      "presentation": "Placeholder page route; ProductDialog remains the existing quick-view overlay."
    },
    "Orders": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    },
    "Livechat": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    },
    "Profile": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomNavigation"
    },
    "Search": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Cart": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Checkout": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "OrderSuccess": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "OrderTracking": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Wishlist": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    },
    "Contact": {
      "implemented": true,
      "content_status": "placeholder",
      "navigation": "BottomActionBar"
    }
  },
  "components": {
    "Header": {
      "implemented": true,
      "source": "App.jsx"
    },
    "BrandLockup": {
      "implemented": true,
      "source": "App.jsx"
    },
    "MainNavigation": {
      "implemented": true,
      "source": "App.jsx",
      "behavior_source": "App.jsx"
    },
    "HeaderCTA": {
      "implemented": true,
      "source": "App.jsx"
    },
    "HeroSection": {
      "implemented": true,
      "source": "App.jsx"
    },
    "IntroStrip": {
      "implemented": true,
      "source": "App.jsx"
    },
    "FeaturedProductsSection": {
      "implemented": true,
      "source": "App.jsx"
    },
    "CatalogToolbar": {
      "implemented": true,
      "source": "App.jsx"
    },
    "ProductSearch": {
      "implemented": true,
      "source": "App.jsx",
      "behavior_source": "App.jsx"
    },
    "ProductGrid": {
      "implemented": true,
      "source": "App.jsx",
      "style_source": "style.css"
    },
    "ProductCard": {
      "implemented": true,
      "source": "App.jsx",
      "style_source": "style.css"
    },
    "ProductDialog": {
      "implemented": true,
      "source": "App.jsx",
      "rendering": "native HTML dialog"
    },
    "LoadingState": {
      "implemented": true,
      "source": "App.jsx",
      "initial_fallback_source": "index.html"
    },
    "ErrorState": {
      "implemented": true,
      "source": "App.jsx"
    },
    "EmptyState": {
      "implemented": true,
      "source": "App.jsx"
    },
    "Footer": {
      "implemented": true,
      "source": "App.jsx"
    },
    "BottomNavigation": {
      "implemented": true,
      "source": "App.jsx",
      "style_source": "style.css",
      "pages": [
        "Home",
        "Products",
        "Profile"
      ]
    },
    "BottomActionBar": {
      "implemented": true,
      "source": "App.jsx",
      "style_source": "style.css",
      "pages": [
        "ProductDetail",
        "Search",
        "Cart",
        "Checkout",
        "OrderSuccess",
        "OrderTracking",
        "Wishlist",
        "Contact"
      ]
    },
    "PageFooter": {
      "implemented": true,
      "source": "App.jsx",
      "placement": "Inside each page"
    }
  },
  "data": {
    "provider": "Supabase Edge Function",
    "source_of_truth": "public.products",
    "endpoint": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-products",
    "method": "GET",
    "client": "browser fetch()",
    "service_source": "App.jsx",
    "expected_response": {
      "success": "boolean",
      "data": "array",
      "total": "number"
    },
    "rules": [
      "Do not query the products table directly from this frontend.",
      "Do not add hardcoded or demo product fallback data.",
      "Validate the HTTP response and expected JSON fields before rendering.",
      "Keep loading, error, retry, and empty states explicit."
    ]
  },
  "styles": {
    "global_stylesheet": "style.css",
    "design_system_blueprint": "blueprint-design-system.json",
    "design_system_documentation": "docs/DESIGN_SYSTEM.md",
    "responsive_strategy": "mobile-only",
    "layout_contract": {
      "html_body": "width: 100%; height: 100%; margin: 0",
      "root": "#root",
      "app_shell": "full-height flex column",
      "main": "flexible primary content region"
    },
    "rule": "The design system blueprint is the source of truth for visual tokens; avoid duplicating token definitions in this file.",
    "mobile_only": {
      "minimum_viewport_width_px": 320,
      "maximum_viewport_width_px": 767,
      "wide_viewport_behavior": "Application remains centered and capped at 767px; no desktop or tablet layout is provided."
    }
  },
  "repository_files": {
    "index.html": "HTML document, root mount point, React and Babel CDN runtime, and App.jsx entry",
    "App.jsx": "React application, components, navigation, product fetching, search, and product dialog",
    "style.css": "Global styles, layout, components, and responsive rules",
    "README.md": "Project overview, technology, data source, local preview, and GitHub Pages instructions",
    "blueprint-design-system.json": "Structured design-system specification and visual token source",
    "docs/DESIGN_SYSTEM.md": "Human-readable design-system documentation",
    "structure.json": "Application structure and architecture blueprint"
  },
  "constraints": [
    "Describe the current implementation as a React CDN application with native CSS and no build step.",
    "Do not claim Vite, TypeScript, npm scripts, React Router, or a build pipeline are implemented.",
    "React and ReactDOM are loaded from CDN; Babel Standalone compiles JSX in the browser.",
    "Keep the product detail experience as a native HTML dialog unless a separate route is explicitly approved.",
    "Do not add demo product fallback data when the Supabase Edge Function request fails.",
    "Architecture changes must be reflected in this file when the implementation changes.",
    "BottomNavigation is exclusive to Home, Products, and Profile.",
    "BottomActionBar is exclusive to ProductDetail, Search, Cart, Checkout, OrderSuccess, OrderTracking, Wishlist, and Contact.",
    "Do not represent placeholder routes as completed commerce features."
  ]
}
