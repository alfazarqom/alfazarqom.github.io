{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "Asri Collection App Structure",
    "artifact": "structure.json",
    "version": "1.1.0",
    "status": "current",
    "purpose": "Application architecture and UI composition blueprint",
    "source_of_truth": true,
    "last_updated": "2026-11-05"
  },
  "project": {
    "name": "Asri Collection",
    "repository": "alfazarqom/alfazarqom.github.io",
    "platform": "GitHub Pages",
    "application_type": "static-web-storefront",
    "locale": "id-ID",
    "currency": "IDR"
  },
  "architecture": {
    "pattern": "single-page static application",
    "runtime": "React 18 UMD and ReactDOM 18 UMD loaded from CDN; Babel Standalone compiles JSX in the browser; native CSS",
    "framework": "React 18 (CDN UMD)",
    "language": [
      "HTML5",
      "JSX",
      "JavaScript",
      "CSS"
    ],
    "build_required": false,
    "routing": {
      "type": "in-page React state navigation synchronized with URL hash",
      "library": null,
      "mechanism": "React state and window.location.hash",
      "implemented_pages": [
        "home",
        "products"
      ]
    },
    "principles": [
      "Keep the current no-build GitHub Pages architecture.",
      "Keep layout ownership at the application shell level.",
      "Separate page content, reusable UI patterns, data access, and styling responsibilities.",
      "Render product data from the Supabase get-products Edge Function; do not add demo product fallbacks.",
      "Treat this file as an architecture reference, not as a claim that conceptual components already exist as separate source files."
    ]
  },
  "app": {
    "root": "#root",
    "component": "App",
    "tree": {
      "App": {
        "element": "#root",
        "children": [
          {
            "component": "AppShell",
            "element": ".app-shell",
            "children": [
              {
                "component": "Header",
                "element": ".site-header",
                "children": [
                  "BrandLockup",
                  "MainNavigation",
                  "HeaderCTA"
                ]
              },
              {
                "component": "Main",
                "element": ".main-content",
                "children": [
                  {
                    "component": "MainContent",
                    "element": ".main-content-inner",
                    "children": [
                      {
                        "component": "PagesLayout",
                        "children": [
                          {
                            "page": "Home",
                            "element": "#home-page",
                            "children": [
                              "HeroSection",
                              "IntroStrip",
                              "FeaturedProductsSection"
                            ]
                          },
                          {
                            "page": "Products",
                            "element": "#products-page",
                            "children": [
                              "CatalogHeading",
                              "CatalogToolbar",
                              "ProductGrid"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "component": "Footer",
                "element": ".site-footer"
              }
            ]
          },
          {
            "component": "ProductDialog",
            "element": ".product-dialog",
            "rendering": "React-controlled native HTML dialog"
          }
        ]
      }
    }
  },
  "layouts": {
    "AppShell": {
      "implemented": true,
      "element": ".app-shell",
      "direction": "column",
      "regions": [
        "Header",
        "Main",
        "Footer"
      ]
    },
    "Main": {
      "implemented": true,
      "element": ".main-content",
      "responsibility": "Primary page viewport and scrolling region"
    },
    "PagesLayout": {
      "implemented": true,
      "element": ".main-content-inner",
      "responsibility": "Contains page sections; only the active page is visible"
    },
    "OverlayLayout": {
      "implemented": "native-dialog",
      "responsibility": "Product detail modal outside the normal document flow"
    }
  },
  "pages": {
    "Home": {
      "implemented": true,
      "element": "#home-page",
      "sections": [
        "HeroSection",
        "IntroStrip",
        "FeaturedProductsSection"
      ]
    },
    "Products": {
      "implemented": true,
      "element": "#products-page",
      "sections": [
        "CatalogHeading",
        "CatalogToolbar",
        "ProductGrid"
      ],
      "features": [
        "ProductSearch",
        "ProductCount"
      ]
    },
    "ProductDetail": {
      "implemented": true,
      "presentation": "ProductDetailDialog",
      "element": ".product-dialog",
      "note": "A native HTML dialog controlled by React, not a standalone route or page."
    },
    "Orders": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    },
    "Livechat": {
      "implemented": false,
      "status": "not-in-current-repository-baseline"
    }
  },
