    "BottomActionBar": {
      "implemented": true,
      "source": "App.jsx",
      "style_source": "style.css",
      "pages": [
        "ProductDetail",
        "Search",
        "Cart",
        "Checkout",
        "OrderSuccess",
        "OrderTracking",
        "Wishlist",
        "Contact"
      ]
    },
    "PageFooter": {
      "implemented": true,
      "source": "App.jsx",
      "placement": "Inside each page"
    },
    "ProductQuickView": {
      "implemented": true,
